# MALAKI environment variables.
# Copy to `.env` for local development (`cp .env.example .env`) and fill in.
# In production set these in your host's secret/environment settings.
# NEVER commit real values. Avoid "$" in values: .env loaders expand $VARS.

# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
# Local dev with `npx prisma dev --name malaki`: postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/malaki?schema=public"
# Optional: maximum database connections per server process. Leave empty in
# production. Set to 1 with the local `prisma dev` database, which drops
# connections when several queries run at once.
DATABASE_POOL_MAX=""

# Public base URL, no trailing slash. Used for Stripe redirects, sitemap, SEO.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ISO 4217 currency you sell in. MALAKI is based in Boston, so USD.
# Prices are stored in minor units (cents).
NEXT_PUBLIC_STORE_CURRENCY="USD"
# Locale for number/currency formatting.
NEXT_PUBLIC_STORE_LOCALE="en-US"

# IANA time zone of the kitchen (Boston). "Today", lead times and dispatch days use it.
STORE_TIMEZONE="America/New_York"

# ─── Stripe (https://dashboard.stripe.com/test/apikeys) ─────────────────────
# Use test keys (sk_test_…) until launch.
STRIPE_SECRET_KEY=""
# Signing secret of the webhook endpoint (whsec_…). Locally: printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=""
# Minutes a checkout holds production capacity / the Stripe session stays open (31–1380).
CHECKOUT_HOLD_MINUTES="60"

# ─── Email ───────────────────────────────────────────────────────────────────
# "console" logs emails (development). "smtp" sends through any SMTP provider.
EMAIL_PROVIDER="console"
EMAIL_FROM="MALAKI <orders@your-domain.example>"
# Optional: where new paid orders and enquiries are notified.
ORDER_NOTIFICATION_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "true" for port 465 (implicit TLS); "false" for 587 (STARTTLS).
SMTP_SECURE="false"

# ─── Admin ───────────────────────────────────────────────────────────────────
ADMIN_EMAIL=""
# Generate with: npm run admin:hash -- "a long unique password"
ADMIN_PASSWORD_HASH=""
# At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=""

# ─── Optional ────────────────────────────────────────────────────────────────
# Privacy-friendly analytics: script URL + the attribute/value the provider expects.
# Plausible-style: NEXT_PUBLIC_ANALYTICS_SITE_ATTRIBUTE="data-domain", SITE_ID="your-domain.example"
# Umami-style:     NEXT_PUBLIC_ANALYTICS_SITE_ATTRIBUTE="data-website-id", SITE_ID="<uuid>"
NEXT_PUBLIC_ANALYTICS_SCRIPT_SRC=""
NEXT_PUBLIC_ANALYTICS_SITE_ATTRIBUTE=""
NEXT_PUBLIC_ANALYTICS_SITE_ID=""

# Server errors are POSTed here as JSON (Slack/Discord webhook, log collector…).
ERROR_WEBHOOK_URL=""
# debug | info | warn | error
LOG_LEVEL="info"

# Extra hosts for product images, comma-separated URL patterns.
IMAGE_REMOTE_PATTERNS=""

# Seed only: fill obviously-fake test prices/stock so checkout can be tested locally.
# SEED_DEMO_PRICES="true"
